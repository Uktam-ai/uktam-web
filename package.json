{
  "name": "uktam-web",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "wrangler dev -c .output/server/wrangler.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "fonts": "bun scripts/fetch-fonts.mjs",
    "logo": "bun scripts/trace-logo.mjs",
    "og": "bun scripts/build-og.mjs",
    "spell": "cspell --no-progress \"**/*.{ts,tsx,md,css,json,mjs}\"",
    "typecheck": "tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun run spell"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.7",
    "@tanstack/router-plugin": "^1.169.0",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "lenis": "^1.3.28",
    "lucide-react": "^0.575.0",
    "ogl": "^1.0.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@cspell/dict-en-gb": "^5.0.38",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.16.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cspell": "^10.5.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^15.15.0",
    "nitro": "3.0.260603-beta",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8"
