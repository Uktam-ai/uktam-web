  "ignoreRegExpList": [
    "/\\b[0-9a-f]{7,40}\\b/g",
    "/#[0-9a-fA-F]{3,8}\\b/g",
    "/\\bu[A-Z][A-Za-z0-9]*/g",
    "/\\b[a-z]+[A-Z][A-Za-z]*Size\\b/g",
    "/[\\u0900-\\u0DFF]+/gu"
  ],

  "ignorePaths": [
    "node_modules/**",
    ".output/**",
    ".vercel/**",
    ".wrangler/**",
    ".tanstack/**",
    "bun.lock",
    "public/**",
    "docs/reference/**",
    "src/routeTree.gen.ts",
    "src/components/fx/splash-shaders.ts",
    "src/components/fx/SplashCursor.tsx",
    "src/components/fx/Ferrofluid.tsx",
    "**/*.svg",
    "**/*.png",
    "**/*.woff2",
    "**/*.ico",
    "cspell.json"
  ]
}
