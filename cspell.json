{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en,en-GB",
  "dictionaries": ["en-gb", "typescript", "node", "css", "html", "softwareTerms"],
  "import": ["@cspell/dict-en-gb/cspell-ext.json"],

  "//": "The site is written in Oxford spelling: -ize for Greek-origin verbs (optimize, recognize, quantize) but British everywhere else (licence as a noun, aeroplane, -yse). That combination is deliberate — it keeps the machine-learning vocabulary spelled the way every GGUF and ONNX document spells it, without making the prose read as American. en-GB accepts both -ise and -ize, so it cannot enforce the choice on its own; the flagWords list below is what actually holds the line.",

  "flagWords": [
    "optimise",
    "optimised",
    "optimises",
    "optimising",
    "optimisation",
    "optimisations",
    "recognise",
    "recognised",
    "recognises",
    "recognising",
    "recognisable",
    "recognition!",
    "quantise",
    "quantised",
    "quantises",
    "quantising",
    "quantisation",
    "serialise",
    "serialised",
    "serialising",
    "serialisation",
    "organise",
    "organised",
    "organising",
    "organisation",
    "synthesise",
    "synthesised",
    "synthesising",
    "normalise",
    "normalised",
    "normalising",
    "normalisation",
    "prioritise",
    "prioritised",
    "prioritising",
    "initialise",
    "initialised",
    "initialising",
    "initialisation"
  ],

  "words": [
    "AI4Bharat",
    "arkts",
    "ashb",
    "backdrop",
    "bharat",
    "bunfig",
    "Catmull",
    "glassmorphism",
