# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Wrangler / Cloudflare
.wrangler/
# Wrangler reads .dev.vars plus per-environment suffixes, and all of them hold
# real secrets. `*.local` above does not cover either these or a bare `.env`.
.dev.vars
.dev.vars.*

# Vercel
# Build output (Build Output API v3) plus project.json, which the Vercel CLI
# writes with the org and project IDs once the repo is linked.
.vercel/

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code local workspace
.claude/

# Generated per-build from the deployment origin — see scripts/site-url.mjs.
# Committing them would be a second place for the domain to go stale.
public/robots.txt
public/sitemap.xml

# Playwright MCP debug artifacts
.playwright-mcp/

# Ad-hoc screenshots from visual iteration. Reference assets that are meant to
# be kept live in docs/reference/, not the repo root.
/*.png
/*.jpg
/*.jpeg
/*.webp
